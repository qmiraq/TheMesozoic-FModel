[HerbivoreChat]
Enabled=true

; Unreal units. 20000 equals the fallback currently used because Game.ini
; does not explicitly define a local-chat range.
LocalChatRange=20000

; GetChatMessage may fire once per native recipient. Identical sender/message
; callbacks inside this window are treated as one spatial send.
DeduplicationMilliseconds=2500

; Beipiaosaurus and Beipiosaurus are treated as aliases for one species.
Herbivores=Beipiosaurus,Beipiaosaurus,Diabloceratops,Dryosaurus,Gallimimus,Hypsilophodon,Kentrosaurus,Maiasaura,Pachycephalosaurus,Stegosaurus,Tenontosaurus,Triceratops
