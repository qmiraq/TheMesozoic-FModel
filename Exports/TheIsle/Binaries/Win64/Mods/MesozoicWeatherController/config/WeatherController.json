[WeatherController]
Enabled=true

; Clear Sky rolls every 10-15 minutes.
ClearMinMinutes=10
ClearMaxMinutes=15

; Every non-clear stage lasts 3-6 minutes.
StageMinMinutes=3
StageMaxMinutes=6

; Matches the two-second transitions observed from the in-game admin panel.
TransitionDurationSeconds=25

; Allows the Gateway weather actor to finish loading after a server restart.
StartupDelaySeconds=20

